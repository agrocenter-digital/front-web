# AWS Cognito
NEXT_PUBLIC_COGNITO_DOMAIN=https://tu-dominio.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=tu_app_client_id
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000

# URL de la EC2 Monolítica (BFF Web en puerto 8080)
# Opción A (Recomendada en Vercel para evitar bloqueo Mixed Content HTTP/HTTPS):
# BACKEND_INTERNAL_URL=http://<IP_PUBLICA_EC2>:8080
# Dejar NEXT_PUBLIC_API_BASE_URL vacío para que el navegador use rutas relativas /api/bff/*
#
# Opción B (Llamada directa desde el navegador si tienes dominio con SSL o en desarrollo local):
NEXT_PUBLIC_API_BASE_URL=http://<IP_PUBLICA_EC2>:8080

# Datos públicos aprobados. Dejar vacíos hasta contar con información comercial real.
# WhatsApp: código de país y número, de 8 a 15 dígitos, sin espacios.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Solo servidor: directorio absoluto PRIVADO y persistente para consultas.
# En desarrollo, vacío utiliza front-web/.data/consultas. Producción exige configurarlo.
CONTACT_STORAGE_DIR=
