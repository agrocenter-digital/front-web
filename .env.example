# AWS Cognito
NEXT_PUBLIC_COGNITO_DOMAIN=https://tu-dominio.auth.us-east-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=tu_app_client_id
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000

# Backend en EC2 Monolítica (BFF Web en puerto 8080)
# En Vercel, Next.js reescribe automáticamente todas las peticiones relativas (/api/*)
# hacia este destino mediante `next.config.ts`, evitando el bloqueo de Mixed Content (HTTPS -> HTTP).
BACKEND_INTERNAL_URL=http://34.201.161.216:8080

# Entornos V1 / V2 para el selector del panel de administración.
# Si se omiten se usan las IPs públicas por defecto (puerto 3000).
# Tras el login, /?env=v1 o /?env=v2 redirige a la EC2 con el access token
# de Cognito en el fragmento (#token=...&idToken=...).
NEXT_PUBLIC_ENV_V1_URL=http://44.195.118.58:3000
NEXT_PUBLIC_ENV_V2_URL=http://34.195.64.174:3000

# URL pública canónica del frontend (metadata/Open Graph).
NEXT_PUBLIC_SITE_URL=https://front-web-seven.vercel.app

# Datos públicos aprobados. Dejar vacíos hasta contar con información comercial real.
# WhatsApp: código de país y número, de 8 a 15 dígitos, sin espacios.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Solo servidor: directorio absoluto PRIVADO y persistente para consultas.
# En desarrollo, vacío utiliza front-web/.data/consultas. Producción exige configurarlo.
CONTACT_STORAGE_DIR=
